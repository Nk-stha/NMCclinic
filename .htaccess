Options -MultiViews
RewriteEngine On

# Never serve source, dumps, plans or dotfiles (db.sql holds the admin hash; the zip holds the whole site).
# .well-known stays reachable for HTTPS certificate checks.
RewriteRule ^(migrations|plan)(/|$) - [F,END]
RewriteRule \.(sql|zip|md)$ - [F,END]
RewriteCond %{REQUEST_URI} !/\.well-known/
RewriteRule (^|/)\. - [F,END]

# %2 below is this folder's URL path ("/" in Docker, "/NMCclinic/" under XAMPP),
# so redirects work wherever the site is installed.
RewriteCond $0#%{REQUEST_URI} ^([^#]*)#(.*)\1$
RewriteRule ^(index\.(html|php)|home/?)$ %2 [R=301,END]

RewriteRule ^about\.(html|php)$ about [R=301,END]
RewriteRule ^specialties\.(html|php)$ specialties [R=301,END]
RewriteRule ^doctors\.(html|php)$ doctors [R=301,END]
RewriteRule ^blog\.(html|php)$ blog [R=301,END]
RewriteRule ^contact\.(html|php)$ contact [R=301,END]

RewriteRule ^$ index.php [END]
RewriteRule ^about/?$ about.php [END]
RewriteRule ^specialties/?$ specialties.php [END]
RewriteRule ^doctors/?$ doctors.php [END]
RewriteRule ^blog/?$ blog.php [END]
RewriteRule ^contact/?$ contact.php [END]

RewriteRule ^blog/([A-Za-z0-9-]+)/?$ blog-detail.php?slug=$1 [END,QSA]
RewriteRule ^blog/.+$ blog-detail.php [END,QSA]

# robots.txt is generated so it can carry the absolute sitemap URL.
RewriteRule ^robots\.txt$ robots.php [END]
RewriteRule ^sitemap\.xml$ sitemap.php [END]

# Anything else that is not a real file or folder gets the branded 404 page.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [END]
