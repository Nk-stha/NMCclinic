# ==============================================================================
# NMC Clinic Environment Configuration Example
# Copy this file to .env and configure your local or production settings.
# ==============================================================================

# Database Connection (Consumed by cms/config/database.php)
NMC_DB_HOST=localhost
NMC_DB_NAME=clinic
NMC_DB_USER=root
NMC_DB_PASS=

# Base Site URL (Consumed by includes/public_seo.php)
# Example local: http://localhost/NMCclinic
# Example production: https://www.nmcclinic.com
SITE_URL=http://localhost/NMCclinic
